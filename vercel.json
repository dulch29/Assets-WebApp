{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/asset-store/index.html" },
    { "source": "/css/:match*", "destination": "/asset-store/css/:match*" },
    { "source": "/js/:match*", "destination": "/asset-store/js/:match*" },
    { "source": "/browse", "destination": "/asset-store/browse" },
    { "source": "/browse.html", "destination": "/asset-store/browse" },
    { "source": "/asset", "destination": "/asset-store/asset" },
    { "source": "/asset.html", "destination": "/asset-store/asset" },
    { "source": "/auth", "destination": "/asset-store/auth" },
    { "source": "/auth.html", "destination": "/asset-store/auth" },
    { "source": "/account", "destination": "/asset-store/account" },
    { "source": "/account.html", "destination": "/asset-store/account" },
    { "source": "/publish", "destination": "/asset-store/publish" },
    { "source": "/publish.html", "destination": "/asset-store/publish" },
    { "source": "/store", "destination": "/asset-store/index.html" },
    { "source": "/store/:path*", "destination": "/asset-store/:path*" },
    { "source": "/kits-overview", "destination": "/asset-store/index.html" }
  ]
}

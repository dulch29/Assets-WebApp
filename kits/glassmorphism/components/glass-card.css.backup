    <p class="hq-glass-card-description">
        Your description goes here. This is the main content of your card.
    </p>
    <div class="hq-glass-card-tags">
        <span class="hq-glass-card-tag">Tag 1</span>
        <span class="hq-glass-card-tag">Tag 2</span>
        <span class="hq-glass-card-tag">Tag 3</span>
    </div>
    <div class="hq-glass-card-actions">

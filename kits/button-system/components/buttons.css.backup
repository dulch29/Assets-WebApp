/* ============================================
   BUTTON SYSTEM - EXTRACTED CSS
   Copy this file into any project
   ============================================ */

/* Base button reset and foundation */
.hq-btn {
    /* Reset */
    border: none;
    outline: none;
    background: none;
    cursor: pointer;
    text-decoration: none;

    /* Typography */
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    font-weight: 500;
    line-height: 1.5;

    /* Layout */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 1vw, 0.75rem);
    padding: clamp(0.625rem, 1.5vw, 0.75rem) clamp(1.25rem, 3vw, 1.5rem);
    border-radius: 999px;

    /* Transitions */
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);

    /* Interaction */
    user-select: none;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
}

.hq-btn:focus-visible {
    outline: 2px solid #3B6DFF;
    outline-offset: 2px;
}

/* ============================================
   SEMANTIC VARIANTS
   ============================================ */

/* PRIMARY - Main call-to-action */
.hq-btn-primary {
    background: #3B6DFF;
    color: rgba(0, 0, 0, 0.90);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.hq-btn-primary:hover:not(:disabled) {
    background: #5B85FF;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.4), 0 0 20px rgba(59, 109, 255, 0.3);
}

.hq-btn-primary:active:not(:disabled) {
    background: #2450E6;
    transform: translateY(0);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

/* SECONDARY - Alternative action */
.hq-btn-secondary {
    background: #1E2636;
    color: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.hq-btn-secondary:hover:not(:disabled) {
    background: #2A3142;
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.hq-btn-secondary:active:not(:disabled) {
    background: #161D2B;
    transform: translateY(0);
}

/* SUCCESS - Positive confirmation */
.hq-btn-success {
    background: #6EE7B7;
    color: rgba(0, 0, 0, 0.90);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.hq-btn-success:hover:not(:disabled) {
    background: #8EEDC7;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.4), 0 0 20px rgba(110, 231, 183, 0.3);
}

.hq-btn-success:active:not(:disabled) {
    background: #4FD9A0;
    transform: translateY(0);
}

/* DANGER - Destructive action */
.hq-btn-danger {
    background: #FF6B6B;
    color: rgba(0, 0, 0, 0.90);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.hq-btn-danger:hover:not(:disabled) {
    background: #FF8585;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.4), 0 0 20px rgba(255, 107, 107, 0.3);
}

.hq-btn-danger:active:not(:disabled) {
    background: #E65555;
    transform: translateY(0);
}

/* WARNING - Caution required */
.hq-btn-warning {
    background: #FFA94D;
    color: rgba(0, 0, 0, 0.90);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.hq-btn-warning:hover:not(:disabled) {
    background: #FFB76D;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.4), 0 0 20px rgba(255, 169, 77, 0.3);
}

.hq-btn-warning:active:not(:disabled) {
    background: #E69540;
    transform: translateY(0);
}

/* GHOST - Minimal, text-like */
.hq-btn-ghost {
    background: transparent;
    color: rgba(255, 255, 255, 0.95);
    border: 1px solid transparent;
}

.hq-btn-ghost:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
}

.hq-btn-ghost:active:not(:disabled) {
    background: rgba(255, 255, 255, 0.08);
}

/* OUTLINE - Bordered variant */
.hq-btn-outline {
    background: transparent;
    color: #3B6DFF;
    border: 2px solid #3B6DFF;
}

.hq-btn-outline:hover:not(:disabled) {
    background: #3B6DFF;
    color: rgba(0, 0, 0, 0.90);
    transform: translateY(-1px);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.hq-btn-outline:active:not(:disabled) {
    transform: translateY(0);
}

/* ============================================
   SIZE VARIANTS
   ============================================ */
.hq-btn-sm {
    font-size: clamp(0.875rem, 1.25vw, 1rem);
    padding: clamp(0.375rem, 1vw, 0.5rem) clamp(0.875rem, 2vw, 1rem);
    gap: clamp(0.25rem, 0.5vw, 0.5rem);
}

.hq-btn-lg {
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    padding: clamp(0.875rem, 2vw, 1rem) clamp(1.75rem, 4vw, 2rem);
    gap: clamp(0.75rem, 1.5vw, 1rem);
}

.hq-btn-xl {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    padding: clamp(1rem, 2.5vw, 1.25rem) clamp(2rem, 5vw, 2.5rem);
    gap: clamp(1rem, 2vw, 1.5rem);
}

/* ============================================
   BUTTON STATES
   ============================================ */

/* Disabled state */
.hq-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
}

/* Loading state */
.hq-btn-loading {
    position: relative;
    color: transparent !important;
    pointer-events: none;
}

.hq-btn-loading::after {
    content: '';
    position: absolute;
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: hq-btn-spin 0.6s linear infinite;
    color: rgba(255, 255, 255, 0.95);
}

.hq-btn-primary.hq-btn-loading::after,
.hq-btn-success.hq-btn-loading::after,
.hq-btn-danger.hq-btn-loading::after,
.hq-btn-warning.hq-btn-loading::after {
    color: rgba(0, 0, 0, 0.90);
}

@keyframes hq-btn-spin {
    to { transform: rotate(360deg); }
}

/* ============================================
   BUTTON GROUPS
   ============================================ */
.hq-btn-group {
    display: inline-flex;
    gap: 1px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 2px;
}

.hq-btn-group .hq-btn {
    border-radius: 999px;
}

/* ============================================
   ICON BUTTONS
   ============================================ */
.hq-btn-icon {
    padding: clamp(0.625rem, 1.5vw, 0.75rem);
    width: clamp(2.5rem, 5vw, 3rem);
    height: clamp(2.5rem, 5vw, 3rem);
    border-radius: 50%;
}

.hq-btn-icon-sm {
    padding: clamp(0.375rem, 1vw, 0.5rem);
    width: clamp(2rem, 4vw, 2.5rem);
    height: clamp(2rem, 4vw, 2.5rem);
}

.hq-btn-icon-lg {
    padding: clamp(0.875rem, 2vw, 1rem);
    width: clamp(3rem, 6vw, 3.5rem);
    height: clamp(3rem, 6vw, 3.5rem);
}

/* Icon SVG sizing */
.hq-btn svg {
    width: 1.25em;
    height: 1.25em;
    flex-shrink: 0;
}

/* ============================================
   FULL WIDTH BUTTON
   ============================================ */
.hq-btn-block {
    width: 100%;
    display: flex;
}